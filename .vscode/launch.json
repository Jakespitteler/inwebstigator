{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload"
            ],
            "jinja": true,
            "envFile": "${workspaceFolder}/.env",
            "serverReadyAction": {
                "pattern": "Uvicorn running on http://127.0.0.1:([0-9]+)",
                "uriFormat": "http://localhost:%s/docs",
                "action": "openExternally"
            }
        }
    ]
}